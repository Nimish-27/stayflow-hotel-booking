# Copy to .env for your own reference and export these in your shell / IDE run config.
# Spring Boot does NOT load .env files automatically. Never commit real credentials.

DB_URL=jdbc:mysql://localhost:3306/hotel_booking?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC
DB_USER=hotel_app
DB_PASSWORD=change_me

# Used only by the integration tests (a separate schema, wiped by the tests)
TEST_DB_URL=jdbc:mysql://localhost:3306/hotel_booking_test?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC

# Optional overrides (defaults shown)
# APP_TIMEZONE=Asia/Kolkata
# CORS_ALLOWED_ORIGIN=http://localhost:5173
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/sample-data